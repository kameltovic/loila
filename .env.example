OPENROUTER_API_KEY=
# cheap model for live chat, stronger one for the one-off FAQ batch
OPENROUTER_CHAT_MODEL=anthropic/claude-haiku-4.5
OPENROUTER_BATCH_MODEL=anthropic/claude-sonnet-5
DATABASE_PATH=./data/loila.db
OPENROUTER_EXPAND_MODEL=google/gemini-3.5-flash-lite
# Global anti-runaway cap: max live LLM calls per UTC day across the whole site (FAQ batch excluded). 0 = unlimited.
LLM_DAILY_BUDGET=500
# Dossier wizard: analysis/questions model and its allowed OpenRouter providers (comma-separated slugs; empty = US-based default list)
WIZARD_ANALYSIS_MODEL=deepseek/deepseek-v4-flash-0731
WIZARD_PROVIDERS=
SITE_URL=https://loila.fr
# Billing & auth (Stripe test keys locally: npm run stripe:setup creates product + prices)
AUTH_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SWEEGO_API_KEY=
EMAIL_FROM=Loilà <connexion@loila.fr>
# owners (comma-separated): /admin access + notification emails
ADMIN_EMAILS=
# optional: dedicated billing portal configuration (bpc_...)
STRIPE_PORTAL_CONFIGURATION=

# Optional second analytics instance (umami-dev fork)
NEXT_PUBLIC_UMAMI_DEV_URL=
NEXT_PUBLIC_UMAMI_DEV_ID=
